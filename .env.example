# ===================================================================
# TikSentry - Configurações Gerais do Sistema
# ===================================================================
SYSTEM_NAME="TikSentry SOC"
PORT=3000
HOST=0.0.0.0

# Porta UDP do Syslog (514 padrão, 1514 alternativa não-root)
SYSLOG_PORT=514
SYSLOG_FALLBACK_PORT=1514
SYSLOG_HOST=0.0.0.0

# Caminho do Banco de Dados SQLite
DB_PATH=./data/tiksentry.db

# Retenção de dados em dias (apaga logs mais velhos automaticamente)
LOG_RETENTION_DAYS=14

# Coordenadas geográficas do seu Roteador/Datacenter (origem no mapa de ataques)
# Padrão: São Paulo, Brasil (-23.5505, -46.6333)
ROUTER_LAT=-23.5505
ROUTER_LNG=-46.6333
ROUTER_NAME="MikroTik Core Gateway"

# ===================================================================
# Configurações de Conexão com o MikroTik (RouterOS)
# ===================================================================
# Protocolo: "rest" (RouterOS v7) ou "api" (RouterOS v6 e v7 via porta 8728)
MIKROTIK_PROTOCOL=rest
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=443
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=admin
MIKROTIK_USE_TLS=true
MIKROTIK_BLOCK_LIST=TIKSENTRY_BLOCKED
MIKROTIK_AUTO_BLOCK_ENABLED=true
MIKROTIK_DEFAULT_BLOCK_MINUTES=60
